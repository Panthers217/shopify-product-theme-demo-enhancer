<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0f172a">
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% if request.page_type == 'index' %}
      <div class="demo-toast" role="status" aria-live="polite" data-demo-toast>
        <div class="demo-toast__content">
          <p class="demo-toast__title">Demo Site Notice</p>
          <p class="demo-toast__text">This storefront is a public demo built to showcase Shopify development work.</p>
        </div>
        <button class="demo-toast__close" type="button" aria-label="Dismiss demo notice" data-demo-toast-close>
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
    {% endif %}

    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>