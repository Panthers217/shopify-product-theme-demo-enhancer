<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a class="site-logo" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 220 | image_tag: alt: shop.name, loading: 'lazy' }}
      {% else %}
        {{ section.settings.store_title | default: shop.name }}
      {% endif %}
    </a>

    <button class="header-toggle" type="button" data-nav-toggle aria-label="Toggle navigation" aria-expanded="false">
      <span>Menu</span>
    </button>

    {% assign nav_links = linklists['enhancer'].links %}
    {% if nav_links == blank and section.settings.menu != blank %}
      {% assign nav_links = section.settings.menu.links %}
    {% endif %}

    <nav class="site-nav" data-mobile-nav>
      <ul class="site-nav__list">
        {% for link in nav_links %}
          {% assign link_title_lower = link.title | downcase %}
          {% if link_title_lower == 'collections' and link.links.size > 0 %}
            <li class="site-nav__item site-nav__item--has-dropdown">
              <a
                class="site-nav__link site-nav__link--with-caret {% if link.current %}site-nav__link--active{% endif %}"
                href="{{ link.url }}"
                aria-haspopup="true"
                data-dropdown-toggle
              >
                {{ link.title }}
                <svg class="site-nav__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <ul class="site-nav__dropdown" role="list">
                {% for child in link.links %}
                  <li>
                    <a
                      class="site-nav__dropdown-link {% if child.current %}site-nav__dropdown-link--active{% endif %}"
                      href="{{ child.url }}"
                    >
                      {{ child.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </li>
          {% else %}
            <li class="site-nav__item">
              <a
                class="site-nav__link {% if link.current %}site-nav__link--active{% endif %}"
                href="{{ link.url }}"
              >
                {{ link.title }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div class="header-search" data-search-widget data-money-format="{{ shop.money_format }}">
      <button
        class="header-search__toggle"
        type="button"
        data-search-toggle
        aria-label="Search"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="header-search__toggle-label">Search</span>
      </button>

      <div class="header-search__form" data-search-form hidden>
        <div class="header-search__input-wrap">
          <svg class="header-search__input-icon" width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <circle cx="7.5" cy="7.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <input
            class="header-search__input"
            type="search"
            name="q"
            placeholder="Search products…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search products"
            data-search-input
          >
          <button class="header-search__close" type="button" data-search-close aria-label="Close search">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
        <div class="header-search__results" data-search-results hidden></div>
      </div>
    </div>

    <a class="header-cart" href="{{ routes.cart_url }}" aria-label="Cart">
      <span>Cart</span>
      <span class="header-cart__count">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "store_title",
      "label": "Store title fallback",
      "default": "Digital Product Enhancer"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu"
    }
  ]
}
{% endschema %}
