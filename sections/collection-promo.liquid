<section class="collection-promo" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %} {% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}">
  <div class="container collection-promo__inner">
    <div class="collection-promo__content">
      {% if section.settings.title != blank %}
        <h2 class="collection-promo__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="collection-promo__description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.show_cta and section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_url }}" class="collection-promo__cta">
          {{ section.settings.cta_text }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 8H13M10 5L13 8L10 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
    </div>

    {% if section.settings.promo_image != blank %}
      <div class="collection-promo__image">
        {{ section.settings.promo_image | image_url: width: 400 | image_tag: 
          alt: section.settings.title,
          loading: 'lazy',
          sizes: "(max-width: 768px) 100vw, 400px"
        }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .collection-promo {
    padding: 3rem 2rem;
    border-radius: 12px;
    margin-bottom: 3rem;
    transition: transform 0.3s ease;
  }

  .collection-promo:hover {
    transform: translateY(-4px);
  }

  .collection-promo__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .collection-promo__title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .collection-promo__description {
    font-size: 1rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
    opacity: 0.95;
  }

  .collection-promo__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background-color: rgba(255, 255, 255, 0.2);
    border: 2px solid currentColor;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .collection-promo__cta:hover {
    background-color: rgba(255, 255, 255, 0.3);
    transform: translateX(4px);
  }

  .collection-promo__image {
    width: 100%;
    height: 300px;
    overflow: hidden;
    border-radius: 8px;
  }

  .collection-promo__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .collection-promo__inner {
      grid-template-columns: 1fr;
    }

    .collection-promo__title {
      font-size: 1.5rem;
    }

    .collection-promo__image {
      height: 250px;
    }

    .collection-promo {
      padding: 2rem 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Collection promotion",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Special Collection Highlight"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover exclusive products in this curated collection designed for unique experiences."
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promotion image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0ea5e9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show call-to-action button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button URL"
    }
  ]
}
{% endschema %}
