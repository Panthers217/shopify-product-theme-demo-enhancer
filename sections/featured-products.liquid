<section class="featured-products">
  <div class="container">
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    <p class="section-subheading">{{ section.settings.description }}</p>

    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product, button_text: section.settings.button_text %}
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state">
        Select a collection in the Theme Editor to display featured products.
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Digital Products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Curated tools, templates, and downloadable assets for modern digital creators."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View Product"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
