<section class="contact-form-section">
  <div class="container">
    <h1 class="section-heading">{{ section.settings.heading }}</h1>

    {% if section.settings.description != blank %}
      <p class="section-subheading">{{ section.settings.description }}</p>
    {% endif %}

    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <div class="empty-state">Thanks for reaching out. We will get back to you soon.</div>
      {% endif %}

      {% if form.errors %}
        <div class="empty-state">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="contact-grid">
        <label>
          Name
          <input type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}">
        </label>

        <label>
          Email
          <input type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" required>
        </label>

        <label class="contact-grid__full">
          Message
          <textarea name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </label>
      </div>

      <button class="btn" type="submit">{{ section.settings.button_text }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Have questions about the Product Enhancer? Send us a message."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Send message"
    }
  ]
}
{% endschema %}
