<footer class="site-footer" role="contentinfo">
  <div class="container site-footer__inner">
    <div class="site-footer__name">
      {{ section.settings.store_name | default: shop.name }}
    </div>

    {% if section.settings.menu != blank %}
      <ul class="site-footer__menu">
        {% for link in section.settings.menu.links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="site-footer__menu site-footer__menu--blocks">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'footer_link' %}
              {% if block.settings.label != blank and block.settings.url != blank %}
                <li {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
                </li>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </ul>
    {% endif %}

    <div class="site-footer__meta">
      {{ section.settings.footer_text }}
      <br>
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "default": "Digital Product Enhancer Demo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Built with Shopify Online Store 2.0 for portfolio demonstration."
    }
  ],
  "blocks": [
    {
      "type": "footer_link",
      "name": "Footer link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "Support"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}